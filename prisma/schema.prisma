datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  STAFF
  ADMIN
  MANAGER
}

enum TransactionType {
  IN
  OUT
  ADJUST
  TRANSFER
}

// ==========================================
// MODELS
// ==========================================

model User {
  id             Int       @id @default(autoincrement())
  email          String    @unique
  name           String?
  hashedPassword String    @map("hashed_password")
  role           Role      @default(STAFF)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relationships
  sessions          Session[]
  notifications     Notification[]
  stockTransactions StockTransaction[]

  @@map("users")
}

model Session {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  refreshToken String   @unique @map("refresh_token")
  createdAt    DateTime @default(now()) @map("created_at")
  expiredAt    DateTime @map("expired_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  title     String
  content   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Product {
  id          Int      @id @default(autoincrement())
  sku         String   @unique
  name        String
  image       String?
  categoryId  Int      @map("category_id")
  brandId     Int      @map("brand_id")
  description String?
  price       Decimal  @db.Decimal(12, 2) // Dùng Decimal tránh sai số tiền tệ
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relationships
  category     Category           @relation(fields: [categoryId], references: [id])
  brand        Brand              @relation(fields: [brandId], references: [id])
  inventories  Inventory[]
  transactions StockTransaction[]

  @@map("products")
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

model Brand {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  products Product[]

  @@map("brands")
}

model Supplier {
  id          Int       @id @default(autoincrement())
  name        String
  image       String?
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  inventories Inventory[]

  @@map("suppliers")
}

model Warehouse {
  id          Int       @id @default(autoincrement())
  name        String
  address     String
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  inventories  Inventory[]
  transactions StockTransaction[]

  @@map("warehouses")
}

model Inventory {
  id          Int      @id @default(autoincrement())
  productId   Int      @map("product_id")
  warehouseId Int      @map("warehouse_id")
  supplierId  Int      @map("supplier_id")
  quantity    Int      @default(0)
  costPrice   Decimal  @default(0) @map("cost_price") @db.Decimal(12, 2) // Giá nhập
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  supplier  Supplier  @relation(fields: [supplierId], references: [id])

  // RÀNG BUỘC DUY NHẤT: Tránh trùng lặp bộ (Kho - SP - NCC)
  @@unique([warehouseId, productId, supplierId])
  @@map("inventories")
}

model StockTransaction {
  id          Int             @id @default(autoincrement())
  userId      Int             @map("user_id") // BỔ SUNG: Ai là người thực hiện giao dịch này
  productId   Int             @map("product_id")
  warehouseId Int             @map("warehouse_id")
  quantity    Int
  type        TransactionType // Enum IN, OUT, ADJUST, TRANSFER
  note        String?
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  user      User      @relation(fields: [userId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@map("stock_transactions")
}